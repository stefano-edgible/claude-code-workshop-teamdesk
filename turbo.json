{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate-routes": {
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "typecheck": {}
  }
}
